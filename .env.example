# Frontend Environment Variables (Vite)
# Leave empty for local development or all-in-one unified deployment
# Set to your deployed backend URL when deploying frontend separately (e.g., on Vercel)
VITE_API_BASE_URL=https://your-backend-api.onrender.com

# Backend Environment Variables (FastAPI)
# Comma-separated list of allowed frontend domains, or '*' for open access
ALLOWED_ORIGINS=*
PORT=8000

